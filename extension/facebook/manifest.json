{
  "manifest_version": 3,
  "name": "Car capture (Marketplace)",
  "version": "0.1.0",
  "description": "Keeps the vehicle listings you see on Facebook Marketplace, without the sellers, and sends them to your car tracker.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["capture.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Car capture", "default_popup": "popup.html" }
}
